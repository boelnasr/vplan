# Build context for docker/Dockerfile (R8, docs/plan.md W3.4).
# Allowlist: '*' drops everything (also .git, .claude/ with its worktrees, .superpowers/, runs/, .venv and docs/),
# then only what the image copies comes back. A new top-level file reaches the image only by being listed here.
*
!.dockerignore
!LICENSE
!pyproject.toml
!uv.lock
!config/
!docker/
!scripts/
!src/
!tests/

# Dropped at any depth, even inside the directories above. The last matching line wins, so these stay last.
**/.env
**/.env.*
!.env.example
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.venv
**/*.egg-info
